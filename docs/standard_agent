  ### **The Standard Level 4 Agent Node: A Complete Template**

  ```python
  # teams/icp/agents/base.py

  import json
  from typing import Dict, Any, List

  from core.config import Config
  from core.memory.interfaces import MemoryInterface
  from core.tools.tool_executor import ToolExecutor

  class StandardAgentNode:
      def __init__(self, agent_name: str, role_prompt: str):
          self.agent_name = agent_name
          self.role_prompt = role_prompt
          self.llm = Config.get_llm()

      def _generate_response(self, task: str, context: str, memories: List) -> str:
          print(f"[{self.agent_name}] Generating response for task: {task}")
          memories_str = "\n".join([m.get('content', '') for m in memories])
          prompt = f"""
          {self.role_prompt}
          Tools: web_search(query), code_interpreter(code).
          Decide: 1) JSON tool call, or 2) detailed analysis.
          MEMORIES: {memories_str}
          CONTEXT: {context}
          TASK: {task}
          """
          return self.llm.invoke(prompt).content

      def _reflect(self, task: str, response: str) -> Dict[str, Any]:
          print(f"[{self.agent_name}] Reflecting...")
          prompt = f"""
          Critique this response for accuracy, depth, directness.
          Score 0.0-1.0 on a new line, 0.9+ is enterprise-ready.
          TASK: {task}
          RESPONSE: {response}
          """
          critique = self.llm.invoke(prompt).content.strip()
          lines = critique.split('\n')
          return {"critique": "\n".join(lines[:-1]), "score": float(lines[-1])}

      def __call__(self, state: Dict[str, Any]) -> Dict[str, Any]:
          print(f"\n--- Executing Node: {self.agent_name} ---")
          task = state.get("current_task")
          context = state.get("master_context", "")
          memory_service: MemoryInterface = state.get("memory_service")
          tool_executor: ToolExecutor = state.get("tool_executor")

          memories = memory_service.recall(query=f"{context}\n{task}")
          response = self._generate_response(task, context, memories)
          try:
              tool_call = json.loads(response)
              if "tool_name" in tool_call and "tool_input" in tool_call:
                  print(f"[{self.agent_name}] Using tool: {tool_call['tool_name']}")
                  tool_output = tool_executor.execute(tool_call['tool_name'], tool_call['tool_input'])
                  response = self._generate_response(task, context + f"\n{tool_output}", memories)
          except json.JSONDecodeError:
              pass

          reflection = self._reflect(task, response)
          state.update({
              "current_output": response,
              "critique": reflection["critique"],
              "quality_score": reflection["score"]
          })
          return state

  class PsychologicalAgent(StandardAgentNode):
      def __init__(self):
          agent_name = "Psychological Analyst"
          role_prompt = """
          You are a psychological analyst specializing in consumer behavior.
          Uncover unconscious patterns, emotional triggers, and contradictions.
          Provide deep, non-obvious insights.
          """
          super().__init__(agent_name=agent_name, role_prompt=role_prompt)
  ```

# ================================================
# LEVEL 5 AGENTIC INTELLIGENCE SYSTEM
# Environment Variables Template
# ================================================
# Copy this file to .env and add your actual keys
# NEVER commit .env to version control
# ================================================

# -------------------- PRIMARY LLM --------------------
# Choose ONE primary LLM provider (Anthropic recommended for Level 5)

# Option 1: Claude (Recommended for superior reasoning)
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-ANTHROPIC-KEY-HERE
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Option 2: OpenAI (Alternative)
# OPENAI_API_KEY=sk-YOUR-OPENAI-KEY-HERE
# OPENAI_MODEL=gpt-4o-mini

# -------------------- SEARCH & RESEARCH --------------------
# Web search capabilities for research agents

# Serper API for web search (2,500 free searches/month)
SERPER_API_KEY=YOUR-SERPER-API-KEY-HERE

# Alternative: Brave Search API
BRAVE_API_KEY=YOUR-BRAVE-SEARCH-KEY-HERE

# -------------------- MONITORING & TRACING --------------------
# LangSmith for observability (FREE tier available)

LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls__YOUR-LANGSMITH-API-KEY-HERE
LANGCHAIN_PROJECT=level5-agentic-system
LANGCHAIN_VERBOSE=true

# -------------------- DATABASE & PERSISTENCE --------------------
# Supabase for vector memory and persistence

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ-YOUR-SUPABASE-ANON-KEY-HERE
SUPABASE_SERVICE_KEY=eyJ-YOUR-SUPABASE-SERVICE-KEY-HERE

# -------------------- LEVEL 5 TEAM CONFIGURATION --------------------
# Team-specific configurations for multi-agent system

# ICP Research Team
level5-team-icp-claude=sk-ant-api03-YOUR-KEY-HERE
level5-team-icp-langsmith=ls__YOUR-KEY-HERE
level5-team-icp-brave=YOUR-BRAVE-KEY-HERE
level5-team-icp-supabase=YOUR-SUPABASE-KEY-HERE

# Sales Team (Future)
# level5-team-sales-claude=sk-ant-api03-YOUR-KEY-HERE
# level5-team-sales-langsmith=ls__YOUR-KEY-HERE

# Operations Team (Future)
# level5-team-ops-claude=sk-ant-api03-YOUR-KEY-HERE
# level5-team-ops-langsmith=ls__YOUR-KEY-HERE

# -------------------- AGENT BEHAVIOR CONFIGURATION --------------------
# Fine-tune agent behaviors

# Temperature settings (0.0-1.0)
AGENT_TEMPERATURE_RESEARCH=0.3     # Lower for factual research
AGENT_TEMPERATURE_CREATIVE=0.8     # Higher for creative tasks
AGENT_TEMPERATURE_ANALYTICAL=0.1   # Very low for data analysis

# Token limits
MAX_TOKENS_RESEARCH=4096
MAX_TOKENS_CREATIVE=8192
MAX_TOKENS_SUMMARY=2048

# Memory settings
MEMORY_ENABLED=true
MEMORY_RETENTION_DAYS=30
MEMORY_VECTOR_DIMENSIONS=1536

# -------------------- APPLICATION CONFIGURATION --------------------
# FastAPI and deployment settings

# Server configuration
PORT=8000
HOST=0.0.0.0
RELOAD=true
WORKERS=1

# Environment
ENVIRONMENT=development  # development | staging | production
DEBUG=true
LOG_LEVEL=INFO

# Security (generate your own secret key)
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# -------------------- RAILWAY DEPLOYMENT --------------------
# Railway-specific environment variables (auto-set by Railway)

# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=your-project-id
# RAILWAY_SERVICE_ID=your-service-id
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# -------------------- OPTIONAL INTEGRATIONS --------------------
# Additional services you might want to add

# Pinecone for vector database (alternative to Supabase)
# PINECONE_API_KEY=YOUR-PINECONE-KEY
# PINECONE_ENVIRONMENT=us-east-1

# Webhook for notifications
# WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email service for reports
# SENDGRID_API_KEY=SG.YOUR-SENDGRID-KEY
# EMAIL_FROM=noreply@yourdomain.com

# -------------------- FEATURE FLAGS --------------------
# Enable/disable features

ENABLE_INTERVIEWS=true
ENABLE_COMPETITOR_ANALYSIS=true
ENABLE_MARKETING_SYNTHESIS=true
ENABLE_CONVERSION_COPY=true
ENABLE_PSYCHOLOGICAL_ANALYSIS=true
ENABLE_BELIEF_MAPPING=true

# -------------------- NOTES --------------------
# 1. Copy this file to .env before adding your keys
# 2. Never commit .env to version control
# 3. Add .env to your .gitignore file
# 4. For Railway deployment, add these as environment variables
# 5. For local development, use the .env file
# ================================================